# Copy to .env and fill in. Never commit real keys.
XAI_API_KEY=
GEMINI_API_KEY=
# Optional: browser token. If unset, the server generates one per boot and prints it.
DESK_TOKEN=
# Optional model overrides
GROK_MODEL=grok-4.5
GEMINI_MODEL=gemini-3.8-flash
# Dev only: MOCK_PROVIDERS=1 returns canned replies without calling APIs.
# MOCK_PROVIDERS=
