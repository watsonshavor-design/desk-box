# Copy to .env and fill in. Never commit real keys.
XAI_API_KEY=
GEMINI_API_KEY=
# Optional: browser token. If unset, the server generates one per boot and prints it.
DESK_TOKEN=
# Optional model overrides
GROK_MODEL=grok-4.5
GEMINI_MODEL=gemini-3.8-flash
# Dev only: MOCK_PROVIDERS=1 returns canned replies without calling APIs.
# MOCK_PROVIDERS=

# Moomoo OpenAPI (gateway-free REST at webapi.moomoo.com) — optional
# Traditional API Key auth: AppKey id + Ed25519/RSA private key (PEM).
# Create AppKey and upload public key at https://open.moomoo.com/dashboard
MOOMOO_APP_KEY=
MOOMOO_RSA_PRIVATE_KEY=
# Optional OpenD fallback (local gateway) — not reachable from Railway by default
# MOOMOO_OPEND_HOST=127.0.0.1
# MOOMOO_OPEND_PORT=11111
